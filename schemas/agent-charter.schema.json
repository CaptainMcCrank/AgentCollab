{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CaptainMcCrank/AgentCollab/schemas/agent-charter.schema.json",
  "title": "agent_charter block (protocol/Agent_Charter.md)",
  "type": "object",
  "required": ["version", "id", "specialization", "write_scopes", "approval", "handoff"],
  "properties": {
    "version": { "type": "number" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+\\.[0-9]+$"
    },
    "specialization": { "type": "string", "minLength": 1 },
    "write_scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "approval": {
      "type": "object",
      "required": ["autonomous", "overseer", "human"],
      "properties": {
        "autonomous": { "type": "array", "items": { "type": "string" } },
        "overseer": { "type": "array", "items": { "type": "string" } },
        "human": { "type": "array", "items": { "type": "string" } }
      }
    },
    "handoff": {
      "type": "object",
      "required": ["on_exit", "on_receive"],
      "properties": {
        "on_exit": { "enum": ["context_handoff"] },
        "on_receive": { "enum": ["inventory_first"] }
      }
    },
    "pubkey": { "type": "string", "minLength": 1 }
  }
}
